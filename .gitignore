# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env: ignore all env files with secrets; only *.example files are committed
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local

# Certificates and keys. Added before deployment work — a TLS cert or an SSH key
# committed by accident is the classic way a private key ends up public.
*.pem
*.key
*.crt
*.p12
*.pfx

# Local Docker overrides commonly hold host-specific secrets
docker-compose.override.yml

# Test and coverage output
coverage/
.vitest/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Windows
Thumbs.db
Desktop.ini
