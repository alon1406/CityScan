node_modules
dist

# Env: ignore all env files with secrets; only *.example files are committed.
# `.env.development.example` matches `.env.*`, so the negation must cover it too —
# `!.env.example` alone silently drops the per-profile examples.
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local

# User-uploaded hazard photos. The directory itself is kept via .gitkeep.
uploads/*
!uploads/.gitkeep

*.log
