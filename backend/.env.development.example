# =============================================================================
# Development profile. Copy to .env.development
# Loaded when NODE_ENV=development (which `npm run dev` sets for you).
# Overrides .env; overridden by real OS environment variables.
# =============================================================================

# Local MongoDB from docker-compose.dev.yml. Start it with: npm run db:up
# To develop against Atlas instead, just paste the Atlas URI here — no code changes.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cityscan_dev

# Not required in dev (falls back to a named insecure constant with a warning),
# but set it if you want tokens to survive a restart.
JWT_SECRET=

# Unset = allow all origins. Fine locally, refused in production.
FRONTEND_URL=

# Point at the local ai-service (npm run dev:ai at the repo root, port 8001).
# Leave empty to run without AI — duplicate detection degrades to geo matching.
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=

PUBLIC_BASE_URL=http://localhost:5000
