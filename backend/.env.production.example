# =============================================================================
# Production profile. Copy to .env.production
# Loaded when NODE_ENV=production (which `npm start` sets for you).
#
# On a real host (Docker, Render) prefer injecting these as real environment
# variables — those take precedence over this file and never touch the disk.
#
# The server refuses to start in production if JWT_SECRET or FRONTEND_URL is missing.
# =============================================================================

# MongoDB Atlas M0 connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cityscan

# REQUIRED. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# REQUIRED. Comma-separated list of allowed origins.
FRONTEND_URL=https://cityscan.duckdns.org

# Server-to-server call to the AI service. Both must be set for AI to run.
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_API_KEY=

# Must match the public origin so photo URLs resolve for clients.
PUBLIC_BASE_URL=https://cityscan.duckdns.org

RATE_LIMIT_MAX=200
