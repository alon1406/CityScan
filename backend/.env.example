# =============================================================================
# Shared defaults. Loaded LAST, so anything in .env.{NODE_ENV} overrides it,
# and real OS environment variables override both.
#
# Profile files:
#   .env.development  -> local MongoDB (docker-compose.dev.yml)
#   .env.production   -> MongoDB Atlas
#
# Copy this file to .env and fill in what you need. Never commit .env itself.
# =============================================================================

# --- Server ---
PORT=5000

# --- Database ---
# Overridden per profile. See .env.development.example / .env.production.example
MONGODB_URI=
MONGODB_DB_NAME=cityscan

# --- JWT ---
# Required in production and must be >= 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated origins. Required in production; unset in dev means "allow all".
FRONTEND_URL=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# --- AI service (optional) ---
# When unset, duplicate detection falls back to geo matching only and the server
# says so at boot. Set both when ai-service is running.
AI_SERVICE_URL=
AI_SERVICE_API_KEY=

# --- Photo storage ---
# Photos are compressed to WebP and written to disk. Only the URL is stored in MongoDB.
UPLOADS_DIR=uploads
# Absolute base for photo URLs. Leave empty to emit relative URLs (works behind any proxy).
PUBLIC_BASE_URL=
PHOTO_MAX_COUNT=10
PHOTO_MAX_WIDTH=1600
PHOTO_WEBP_QUALITY=80

# --- Domain ---
DUPLICATE_RADIUS_METERS=50
DEMO_ADMIN_EMAIL=admin-demo@cityscan.demo
DEMO_USER_EMAIL=user-demo@cityscan.demo
DEMO_PASSWORD=demo123
